# AI Provider: auto | openai | offline
AI_PROVIDER=auto

# OpenAI API key (enables OpenAI provider when AI_PROVIDER=auto)
OPENAI_API_KEY=

# Optional: OpenAI-compatible base URL (e.g., OpenRouter, Azure, local proxies)
OPENAI_BASE_URL=

# --- OpenRouter example (free chat model, no billing needed) ---
# AI_PROVIDER=openai
# OPENAI_API_KEY=sk-or-...
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# EMBEDDING_MODEL=openai/text-embedding-3-small
# CHAT_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Embedding model (OpenAI provider only)
EMBEDDING_MODEL=text-embedding-3-small

# Chat model (OpenAI provider only)
CHAT_MODEL=gpt-4o-mini

# SQLite database path (relative to backend working dir)
DB_PATH=./data/knowledge.db

# Chunking parameters
CHUNK_MAX_CHARS=1000
CHUNK_OVERLAP_CHARS=150
CHUNK_MIN_CHARS=50

# URL fetching parameters
FETCH_TIMEOUT_SECONDS=10
FETCH_MAX_BYTES=5000000
# Some sites (e.g. Wikipedia) block UAs without contact info; keep a contact URL here
FETCH_USER_AGENT=Mozilla/5.0 (compatible; TuriumBot/1.0; +https://example.com/turium)

# Allow private IPs in URL fetching (for testing only)
ALLOW_PRIVATE_URLS=false

# Query defaults
DEFAULT_TOP_K=5
MAX_TOP_K=20

# Offline embedding dimension
OFFLINE_EMBEDDING_DIM=512

# Log level
LOG_LEVEL=INFO